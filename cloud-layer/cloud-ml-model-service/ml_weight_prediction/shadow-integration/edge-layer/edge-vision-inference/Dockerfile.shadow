FROM python:3.11-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 libsm6 libxext6 libxrender1 libgomp1 libgcc-s1 curl \
  && rm -rf /var/lib/apt/lists/*
COPY requirements-shadow.txt /tmp/requirements-shadow.txt
RUN pip install --no-cache-dir -r /tmp/requirements-shadow.txt
COPY app /app/app
COPY tests /app/tests
COPY pytest.ini /app/pytest.ini
ENV PYTHONPATH=/app
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/ready')"
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
