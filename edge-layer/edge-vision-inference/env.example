# Server Configuration
PORT=8000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=INFO

# JWT Configuration
# IMPORTANT: Generate a secure random secret using: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_ACCESS_SECRET=<generate-secure-random-string>
JWT_ISSUER=microplate-auth-service
JWT_AUDIENCE=microplate-api

# Database
DATABASE_URL=postgresql://farmiq:farmiq_dev@postgres:5432/farmiq

# Media store (S3 via edge-media-store)
MEDIA_STORE_URL=http://edge-media-store:3000

# Model Configuration
MODEL_VERSION=v1.0.0
CONFIDENCE_THRESHOLD=0.5
NMS_THRESHOLD=0.4

# Opt-in only.  When false, the legacy inference path is unchanged.
HYBRID_TRIAL_ENABLED=false
HYBRID_TRIAL_MODEL_DIR=/app/runtime-models/hybrid-trial-75s25v-v1-edge

# Service URLs
WEIGHVISION_SESSION_URL=http://edge-weighvision-session:3000

# Datadog
DD_SERVICE=edge-vision-inference
DD_ENV=development
