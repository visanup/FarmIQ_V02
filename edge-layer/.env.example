COMPOSE_PROJECT_NAME=farmiq-edge

POSTGRES_USER=farmiq
POSTGRES_PASSWORD=farmiq_dev
POSTGRES_DB=farmiq

PGADMIN_DEFAULT_EMAIL=admin@farmiq.com
PGADMIN_DEFAULT_PASSWORD=admin123

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

MQTT_TLS_ENABLED=false

# Point to cloud-layer when doing real edge-to-cloud integration.
CLOUD_INGESTION_URL=http://host.docker.internal:5122/api/v1/edge/batch
CLOUD_INGESTION_URL_REQUIRED=true
CLOUD_AUTH_MODE=api_key
CLOUD_API_KEY=edge-local-key
CLOUD_HMAC_SECRET=

# Point to cloud BFF when policy sync is enabled locally.
BFF_BASE_URL=http://host.docker.internal:5125
EDGE_CLOUD_TOKEN=
EDGE_CONTEXTS=[]

VITE_TENANT_ID=t-001
VITE_CONNECTION_PROFILE=local
VITE_EDGE_HOST=127.0.0.1
VITE_AUTH_MODE=none
